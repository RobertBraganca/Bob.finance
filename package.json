{
  "name": "bob-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "db:seed": "tsx server/src/db/seed.ts",
    "typecheck": "tsc -b tsconfig.build.json --pretty",
    "db:generate": "drizzle-kit generate",
    "demo": "tsx scripts/demo.ts",
    "import:real": "tsx scripts/import-real.ts",
    "seed:investments": "tsx scripts/seed-investments.ts",
    "categorias:mobills": "tsx scripts/add-mobills-categories.ts",
    "picpay:normalize": "tsx scripts/normalize-picpay.ts",
    "regras:locais": "tsx scripts/apply-local-rules.ts",
    "recolor:categories": "tsx scripts/recolor-categories.ts",
    "test:assistant": "tsx --test scripts/assistant/*.test.ts",
    "test:clients": "tsx --test scripts/clients/*.test.ts",
    "test:tasks": "tsx --test --test-concurrency=1 scripts/tasks/*.test.ts",
    "test:accountant": "tsx --test scripts/accountant/*.test.ts",
    "test:irpf": "tsx --test scripts/irpf/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fastify/cors": "^11.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
