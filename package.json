{
  "name": "bob-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "db:push": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts",
    "db:reset": "tsx server/src/db/reset.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:backup:prune": "tsx scripts/backup-prune.ts",
    "typecheck": "tsc -b tsconfig.build.json --pretty",
    "verify": "tsx scripts/verify.ts && tsx scripts/verify-backup.ts",
    "verify:backup": "tsx scripts/verify-backup.ts",
    "db:generate": "drizzle-kit generate",
    "demo": "tsx scripts/demo.ts",
    "import:real": "tsx scripts/import-real.ts",
    "seed:investments": "tsx scripts/seed-investments.ts",
    "categorias:mobills": "tsx scripts/add-mobills-categories.ts",
    "picpay:normalize": "tsx scripts/normalize-picpay.ts",
    "regras:locais": "tsx scripts/apply-local-rules.ts",
    "recolor:categories": "tsx scripts/recolor-categories.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "papaparse": "^5.6.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
